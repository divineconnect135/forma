
NODE_ENV=development

# Forma API
PORT=5001

# MongoDB
# Matches our earlier Mac setup using Docker port 27018.
MONGODB_URI=mongodb://127.0.0.1:27018/forma_dev?replicaSet=rs0&directConnection=true

# Replace with a securely generated secret.
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SESSION_SECRET

# Local development does not require a trusted proxy.
TRUST_PROXY=0

LOG_LEVEL=info
