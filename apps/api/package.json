{
  "name": "@forma/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "seed:products": "tsx src/scripts/seedProducts.ts",
    "seed:variants": "tsx src/scripts/seedVariants.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "connect-mongo": "^6.0.0",
    "dotenv": "^17.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "express-session": "^1.19.0",
    "helmet": "^8.0.0",
    "mongodb": "^7.7.0",
    "mongoose": "^9.0.0",
    "pino": "^10.0.0",
    "stripe": "^23.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^6.0.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
