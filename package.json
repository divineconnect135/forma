{
  "name": "forma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <27" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w @forma/api\" \"npm run dev -w @forma/web\"",
    "build": "npm run build -w @forma/api && npm run build -w @forma/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
